# Copy to .env and fill in. .env stays on this machine (it is gitignored).
#
# Gmail blocks the normal account password over IMAP. Create an app password:
# Google Account → Security → 2-Step Verification → App passwords.
# Turn on IMAP: Gmail → Settings → See all settings → Forwarding and POP/IMAP.
# The same Google app password works for IMAP and SMTP.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Additional mailboxes: put each in credentials/<name>.env with the same two keys.
